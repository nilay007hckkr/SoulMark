# Copy to .env and change the values. .env is git-ignored.
# PIN the organizer types to create events, show the QR and revoke badges.
ORGANIZER_PIN=change-me-123456
# Secret used to sign the rotating QR codes and claim vouchers (any long random string).
QR_SECRET=replace-with-a-long-random-string
# Name shown as the badge issuer.
ORGANIZER_NAME=SoulMark Demo Org
# true = show the 6-digit sign-in key on screen (no email service needed).
DEMO_MODE=true
# Optional: public URL encoded in the QR (e.g. http://192.168.1.20:3000). Defaults to the LAN IP.
PUBLIC_BASE_URL=

# --- Round 2 ---
# true only when the app runs behind a tunnel/reverse proxy (uses CF-Connecting-IP / the proxy-added X-Forwarded-For entry).
TRUST_PROXY=false
# Max sign-in key requests per client IP per 10 minutes (classrooms often share one NAT IP).
OTP_IP_LIMIT=20
# Pending (FIXES.md F1/F2/F5/F6): fill these only when those features are wired up. Never commit real values.
ISSUER_PRIVATE_KEY=
RPC_URL=
SOULMARK_CONTRACT=
GOOGLE_CLIENT_ID=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
